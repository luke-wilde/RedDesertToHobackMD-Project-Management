library(tidyverse); library(sf)
load("C:/Users/lwilde2/Desktop/RDH Database/RD2H_GPSCollarData/RD2H_CleanData.RData")
load("C:/Users/lwilde2/Desktop/RDH Database/RD2H_GPSCollarData/RDH_Sawyer.RData")
rdh_data.sf_sawyer <- rdh_data.sf_sawyer %>% mutate(AID = as.integer(AID), Date = as.character(Date), Month = as.double(Month), Day = as.double(Day)) %>% st_transform(., crs = st_crs(rdh_data.sf))
rdh_data.sf <- rdh_data.sf %>% mutate(POSIXct = with_tz(POSIXct, "MST")) %>% mutate(diff = as.double(diff))
all_rdh_data.sf <- bind_rows(rdh_data.sf_sawyer,rdh_data.sf) %>% arrange(POSIXct, AID)
save(all_rdh_data.sf, file = "C:/Users/lwilde2/Documents/Collaborations/RobbMerkle_FenceCrossings/RDH_GPSdata_HS+AC+LW+KM+MK_03.14.2025.RData")
